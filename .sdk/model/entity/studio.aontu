      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "studio"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /studios"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 20
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/studios"
          q: {
            exist: [
              "limit"
              "type"
            ]
          }
          s: [
            {
              lit: "studios"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /studios/{studioId}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "studio_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/studios/{studioId}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              studioId: "id"
            }
          }
          s: [
            {
              lit: "studios"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
