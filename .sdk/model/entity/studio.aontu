      sh: "Studio description"
      t: "`$STRING`"
    }
    foundingYear: {
      h: "Founding Year"
      n: "foundingYear"
      r: false
      sh: "Year founded"
      t: "`$INTEGER`"
    }
    games: {
      h: "Games"
      n: "games"
      r: false
      sh: "Released game IDs"
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique studio identifier"
      t: "`$STRING`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      sh: "Studio location"
      t: "`$OBJECT`"
    }
    logo: {
      fo: "uri"
      h: "Logo"
      n: "logo"
      r: false
      sh: "Studio logo URL"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Studio name"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Studio type"
      t: "`$STRING`"
    }
    website: {
      fo: "uri"
