{
  "openapi": "3.0.3",
  "info": {
    "title": "NEXARDA API",
    "description": "The NEXARDA API provides access to a video game price comparison service, allowing users to find deals from over 90 approved retailers. It enables developers to integrate price checks for video games, consoles, and gaming gear directly into their applications. Most endpoints are free to use and don't require authentication.",
    "version": "1.0.0",
    "contact": {
      "email": "devteam@nexarda.com"
    },
    "termsOfService": "https://www.nexarda.com/",
    "x-logo": {
      "url": "https://imgcdn1.nexarda.com/main/static/branding/logo.svg"
    }
  },
  "servers": [
    {
      "url": "https://api.nexarda.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Games",
      "description": "Video game information and details"
    },
    {
      "name": "Prices",
      "description": "Real-time price information for games and gear"
    },
    {
      "name": "Consoles",
      "description": "Game consoles and gaming gear information"
    },
    {
      "name": "Franchises",
      "description": "Game franchise information"
    },
    {
      "name": "Studios",
      "description": "Game studio (developers and publishers) information"
    },
    {
      "name": "Users",
      "description": "User profile information"
    },
    {
      "name": "Search",
      "description": "Search functionality for games and products"
    },
    {
      "name": "Retailers",
      "description": "Approved retailers information"
    },
    {
      "name": "Platform",
      "description": "Platform status and information"
    },
    {
      "name": "Widgets",
      "description": "Embeddable widgets for websites"
    }
  ],
  "paths": {
    "/games": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get list of video games",
        "description": "Retrieve a list of video games with information such as release dates, age ratings, media/screenshots and more",
        "operationId": "getGames",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results to return",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of results to skip for pagination",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Game"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimitError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/games/{gameId}": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get video game by ID",
        "description": "Retrieve detailed information about a specific video game including release dates, age ratings, media, screenshots and more",
        "operationId": "getGameById",
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the game",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Game"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/games/{gameId}/prices": {
      "get": {
        "tags": [
          "Prices"
        ],
        "summary": "Get real-time prices for a video game",
        "description": "Retrieve current prices for a video game from multiple retailers in different currencies (GBP, EUR, USD)",
        "operationId": "getGamePrices",
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the game",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Currency code for price display",
            "schema": {
              "type": "string",
              "enum": [
                "GBP",
                "EUR",
                "USD"
              ],
              "default": "USD"
            }
          },
          {
            "name": "region",
            "in": "query",
            "description": "Region code for regional pricing",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Price"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
