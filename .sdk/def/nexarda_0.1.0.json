    "/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Search for games and products",
        "description": "Search for video games, consoles, and gaming gear",
        "operationId": "search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query string",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by product type",
            "schema": {
              "type": "string",
              "enum": [
                "game",
                "console",
                "gear",
                "all"
              ],
              "default": "all"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results to return",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "games": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Game"
                          }
                        },
                        "consoles": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Console"
                          }
                        },
                        "totalResults": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
